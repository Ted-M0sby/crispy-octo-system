    "print(\"   - 高频关键词TOP20统计表.csv\") \n",
    "print(\"   - 中医药疗效关键词词云图.png\")\n",
    "print(\"   - 高频关键词TOP20条形图.png\")\n",
    "print(\"=" * 60)"
   ]
  }
